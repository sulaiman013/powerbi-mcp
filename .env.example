# Power BI MCP Server configuration. Copy to .env and fill in what you need.
# Every setting is optional; Desktop and offline PBIP work with none of them.

# === Cloud credentials (service principal; only for Power BI Service tools) ===
TENANT_ID=your-azure-tenant-id
CLIENT_ID=your-app-client-id
CLIENT_SECRET=your-app-client-secret

# === Safety ===
# Refuse every tool that changes a model, a report or a file. Accepts 1/true/yes/on.
POWERBI_MCP_READONLY=false
# Seconds before a DAX query is cancelled (Desktop and XMLA).
POWERBI_MCP_QUERY_TIMEOUT=120
# Back up the project files before an offline rename or repair (default: on).
POWERBI_MCP_PBIP_BACKUPS=true

# === Governance ===
# Toggle the security subsystems (default: on). Accepts 1/true/yes/on and 0/false/no/off.
ENABLE_POLICIES=true
ENABLE_PII_DETECTION=true
ENABLE_AUDIT=true
# Use your own policy file instead of config/policies.yaml. If this path is set but the file is
# missing or invalid, queries are refused rather than run with no policies.
# POWERBI_MCP_POLICY_FILE=C:/path/to/policies.yaml
# Where the audit log is written (default: logs/ beside the server).
# POWERBI_MCP_AUDIT_DIR=C:/path/to/audit
# Secret that keys the audit hash chain (HMAC-SHA256). Without it the chain only catches
# accidental edits and naive tampering.
# POWERBI_MCP_AUDIT_KEY=change-me
# Secret that keys the "hash" column policy. Without it a random key is used per session, so
# hashed values cannot be joined across sessions.
# POWERBI_MCP_HASH_KEY=change-me

# === .NET libraries (only if auto-discovery misses them) ===
# ADOMD_DLL_PATH=C:/pbi-dlls
# TOM_DLL_PATH=C:/pbi-dlls
# PYTHONNET_RUNTIME=coreclr   # when only the .NET (Core) builds of ADOMD/TOM are installed

# === Logging ===
LOG_LEVEL=INFO
